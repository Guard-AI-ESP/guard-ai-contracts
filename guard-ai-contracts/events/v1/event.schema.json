{
  "$id": "https://guardai.local/schemas/events/v1/event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardAI Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "site_id", "source", "type", "severity", "timestamp", "payload", "schema_version"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "site_id": { "type": "string", "format": "uuid" },
    "hub_id": { "type": "string" },

    "source": { "type": "string", "enum": ["camera", "network", "sensor", "system"] },
    "type": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
    "timestamp": { "type": "string", "format": "date-time" },

    "payload": { "type": "object", "additionalProperties": true },
    "media_ref": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },

    "schema_version": { "type": "string", "const": "v1" },

    "camera_id": { "type": ["string", "null"] },
    "face_id": { "type": ["string", "null"] },
    "person_name": { "type": ["string", "null"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "is_known": { "type": ["boolean", "null"] },
    "bounding_box": {
      "type": ["object", "null"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "minimum": 0, "maximum": 1 },
        "h": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false
    },

    "mac_address": {
      "type": ["string", "null"],
      "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"
    },
    "ip_address": {
      "type": ["string", "null"],
      "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
    },
    "hostname": { "type": ["string", "null"] },
    "rssi": { "type": ["integer", "null"], "minimum": -120, "maximum": 0 },
    "signature": { "type": ["string", "null"] },
    "scan_type": {
      "type": ["string", "null"],
      "enum": [null, "host_discovery", "port_scan", "service_scan"]
    },
    "drop_count": { "type": ["integer", "null"], "minimum": 0 },
    "direction": {
      "type": ["string", "null"],
      "enum": [null, "inbound", "outbound"]
    }
  }
}
